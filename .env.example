# Supabase (public — safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only — never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: enable mock auth/adapters in local development
USE_MOCK_PROVIDERS=false

# Internal API security — production fails closed without Supabase session.
# Set true ONLY for local/demo when you intentionally want open sim APIs.
ALTUS_ALLOW_UNAUTHENTICATED_SIM=false

# Data persistence mode:
#   simulation — in-memory (tests/demo)
#   supabase   — durable pilot/production (required for weekend traffic)
ALTUS_DATA_MODE=simulation

# Social providers — SIMULATION by default; never commit real secrets
PROVIDER_MODE=SIMULATION
ALLOW_LIVE_AD_PUBLISH=false
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_WEBHOOK_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_WEBHOOK_SECRET=

GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REDIRECT_URI=
GOOGLE_ADS_WEBHOOK_SECRET=
